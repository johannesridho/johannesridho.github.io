---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import ArticleTopLayout from "@layouts/ArticleTopLayout.astro"
import ArticleBottomLayout from "@layouts/ArticleBottomLayout.astro"

// Create the static achievements pages
export async function getStaticPaths() {
	const achievements = await getCollection("achievements")
	return achievements.map((achievement) => ({
		params: { slug: achievement.slug },
		props: achievement,
	}))
}

// Get the requested achievements
type Props = CollectionEntry<"achievements">
const achievement = Astro.props
const { title, summary } = achievement.data
---

<PageLayout title={title} description={summary}>
  <TopLayout>
    <div class="animate">
      <ArticleTopLayout entry={achievement}/>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <ArticleBottomLayout entry={achievement} />
    </div>
  </BottomLayout>
</PageLayout>